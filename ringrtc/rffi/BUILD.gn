import("//webrtc.gni")

# C++ source files common to all platforms
common_sources = [
  "src/audio_device.cc",
  "src/injectable_network.cc",
  "src/logging.cc",
  "src/media.cc",
  "src/network.cc",
  "src/peer_connection_factory.cc",
  "src/peer_connection.cc",
  "src/peer_connection_observer.cc",
  "src/ref_count.cc",
  "src/rtp_observer.cc",
  "src/sdp_observer.cc",
  "src/stats_observer.cc",
]

config("ringrtc_rffi_config") {
  include_dirs = [ ".." ]
  defines = [ "ENABLE_RINGRTC" ]
  if (is_ios && target_platform == "watchos") {
    # WEBRTC_IOS is defined on the watch too (it is an iOS variant to the
    # build), but the factory is created here in C++ as on desktop, not by
    # the ObjC SDK. See peer_connection_factory.cc.
    defines += [ "RINGRTC_WATCHOS" ]
  }
}

if (is_android) {
  import("//build/config/android/config.gni")
  import("//build/config/android/rules.gni")

  rtc_shared_library("libringrtc_rffi") {

    visibility = [ "//ringrtc:*" ]

    android_sdk = "//sdk/android"
    # jni_onload.cc -- taken from webrtc/sdk/android/BUILD.gn.
    sources = [
      "${android_sdk}/src/jni/jni_onload.cc",
      "src/android/java_media_stream.cc",
      "src/android/jni_peer_connection.cc",
    ] + common_sources

    # suppressed_config and hide_all_but_jni taken from
    # webrtc/sdk/android/BUILD.gn.
    suppressed_configs += [ "//build/config/android:hide_all_but_jni_onload" ]
    configs += [ "//build/config/android:hide_all_but_jni" ]

    configs += [ ":ringrtc_rffi_config" ]

    ldflags = [ "-Wl,--version-script=" +
               rebase_path("config/rffi_include.lst",
                           root_build_dir) ]

    # deps -- taken from webrtc/sdk/android/BUILD.gn.
    deps = [
      "${android_sdk}:libjingle_peerconnection_jni",
      "${android_sdk}:libjingle_peerconnection_metrics_default_jni",
      "//pc:libjingle_peerconnection",
    ]
    output_extension = "so"
  }
}

if (is_ios) {
  import("//build/config/apple/mobile_config.gni")
}

if (is_ios && target_platform != "watchos") {
  import("//build/config/ios/ios_sdk.gni")
  import("//build/config/ios/rules.gni")

  rtc_static_library("libringrtc_rffi") {

    visibility = [ "//sdk/*:*" ]

    sources = common_sources

    configs += [ ":ringrtc_rffi_config" ]

    deps = [
      "//third_party/libyuv",
    ]
  }
}

if (is_linux || is_mac || is_win || (is_ios && target_platform == "watchos")) {
  rtc_library("libringrtc_rffi") {
    visibility = [ "*" ]

    sources = common_sources

    configs += [ ":ringrtc_rffi_config" ]

    # Need to create field trials (and environment)
    # Without this, we cannot depend on //api:field_trials.
    allow_poison = [ "environment_construction" ]

    deps = [
      "//api:field_trials",
      "//sdk:media_constraints",
      "//media:rtc_simulcast_encoder_adapter",
    ]

    if (is_ios && target_platform == "watchos") {
      # The watch's audio device module. iOS gets its ADM from the ObjC SDK
      # (sdk/objc/native/src/audio, on AudioUnit/VoiceProcessingIO); the watch
      # has neither the ObjC SDK in this build nor AudioToolbox in its SDK, so
      # the ADM is ObjC++ on AVFAudio and lives here.
      sources += [
        "src/watchos/audio_device_watchos.h",
        "src/watchos/audio_device_watchos.mm",
      ]

      # ARC is already on for .mm in this tree: rtc_common_configs adds
      # //build/config/compiler:enable_arc for is_ios. See webrtc.gni.
      frameworks = [
        "AVFAudio.framework",
        "Foundation.framework",
      ]

      deps += [
        "//api:make_ref_counted",
        "//api:scoped_refptr",
        "//api:sequence_checker",
        "//api/units:time_delta",
        "//rtc_base:logging",
        "//rtc_base:macromagic",
        "//rtc_base:platform_thread",
        "//rtc_base:rtc_event",
        "//rtc_base:timeutils",
        "//rtc_base/synchronization:mutex",
      ]
    }
  }
}
